{
  "manifest_version": 2,
  "name": "Lagoon Dark",
  "version": "0.3.2",
  "description": "Lagoon Dark, generated from palettes.json.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lagoon-dark@unyxed-idk-theme",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#1A2B2F",
      "frame_inactive": "#1A2B2F",
      "tab_background_text": "#A0AFAD",
      "tab_text": "#E3EEEA",
      "tab_selected": "#24393D",
      "tab_line": "#EB8878",
      "tab_loading": "#EB8878",
      "tab_background_separator": "#364649",
      "toolbar": "#24393D",
      "toolbar_text": "#E3EEEA",
      "toolbar_field": "#2F4447",
      "toolbar_field_text": "#E3EEEA",
      "toolbar_field_border": "#2A3B3E",
      "toolbar_field_focus": "#2F4447",
      "toolbar_field_text_focus": "#E3EEEA",
      "toolbar_field_border_focus": "#EB8878",
      "toolbar_field_highlight": "#715C58",
      "toolbar_field_highlight_text": "#E3EEEA",
      "toolbar_top_separator": "#1A2B2F",
      "toolbar_bottom_separator": "#2A3B3E",
      "toolbar_vertical_separator": "#364649",
      "popup": "#2E4246",
      "popup_text": "#E3EEEA",
      "popup_border": "#364649",
      "popup_highlight": "#35525A",
      "popup_highlight_text": "#E3EEEA",
      "sidebar": "#1A2B2F",
      "sidebar_text": "#E3EEEA",
      "sidebar_border": "#2A3B3E",
      "sidebar_highlight": "#35525A",
      "sidebar_highlight_text": "#E3EEEA",
      "button_background_hover": "#374B4E",
      "button_background_active": "#3F5255",
      "icons": "#BDCAC7",
      "icons_attention": "#EB8878",
      "ntp_background": "#24393D",
      "ntp_text": "#E3EEEA",
      "ntp_card_background": "#2E4246"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
