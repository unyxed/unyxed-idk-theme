      "settings": {
        "foreground": "#CDC4BA"
      }
    },
    {
      "name": "variable.parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#CDC4BA"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
