# Unyxed IDK Themes: delta features, one per theme. Generated by tools/build.py; do not edit.
# Include this file from ~/.gitconfig and pick a theme (see README):
#   [include]
#       path = <this repo>/ports/delta/unyxed-idk-theme.gitconfig
#   [delta]
#       features = <theme-slug>

[delta "aubergine-dark"]
    dark = true
    syntax-theme = Aubergine Dark
    minus-style = syntax "#5F364D"
    minus-emph-style = syntax "#7D4253"
    plus-style = syntax "#4A484F"
    plus-emph-style = syntax "#576256"
    map-styles = bold purple => syntax "#544069", bold cyan => syntax "#3D4B60"
    line-numbers-minus-style = "#F56F6B"
    line-numbers-plus-style = "#8AC975"
    line-numbers-zero-style = "#8D7B9B"
    line-numbers-left-style = "#3D2F47"
    line-numbers-right-style = "#3D2F47"
    file-style = "#EFE5F2" bold
    file-decoration-style = "#493B52" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#493B52" box
    hunk-header-line-number-style = "#52A6EE"
    commit-decoration-style = "#493B52" box
    blame-palette = "#3A2845 #43314E #45334F"

[delta "aubergine-light"]
    light = true
    syntax-theme = Aubergine Light
    minus-style = syntax "#E0C0C9"
    minus-emph-style = syntax "#D19EA7"
    plus-style = syntax "#CAD1CB"
    plus-emph-style = syntax "#ABBCAB"
    map-styles = bold purple => syntax "#D1C2D7", bold cyan => syntax "#C2CFD7"
    line-numbers-minus-style = "#96161F"
    line-numbers-plus-style = "#2C6829"
    line-numbers-zero-style = "#92849A"
    line-numbers-left-style = "#D9CEDC"
    line-numbers-right-style = "#D9CEDC"
    file-style = "#33243B" bold
    file-decoration-style = "#CEC3D2" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#CEC3D2" box
    hunk-header-line-number-style = "#044782"
    commit-decoration-style = "#CEC3D2" box
    blame-palette = "#F2EBF4 #E8E1EB #E7DFE9"

